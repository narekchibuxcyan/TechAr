# Copy to .env and fill in real values. Never commit the real .env file
# (it is already listed in .claudeignore / .gitignore).

NODE_ENV=development
PORT=4000

# Postgres connection string — no credentials ever hardcoded in source.
DATABASE_URL=postgresql://iot_user:CHANGE_ME@localhost:5432/iot_platform

# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGIN=http://localhost:5173

# 64+ char random string used to derive session cookie signing.
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
SESSION_COOKIE_NAME=iot_session
SESSION_TTL_HOURS=24

# SMTP for OTP + contact-form notification emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM="IoT Platform <no-reply@example.com>"
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Firmware upload limits.
FIRMWARE_MAX_BYTES=67108864
FIRMWARE_STORAGE_DIR=./storage/firmware
